dist/
build/
_artifact/
_build/
carmona/
neomarket/

# Sistema operativo
.DS_Store
Thumbs.db
desktop.ini

# Editores / IDE
.vscode/
.idea/
*.swp

# Logs
*.log
npm-debug.log*
